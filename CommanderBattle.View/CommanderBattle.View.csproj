<Project Sdk="Microsoft.NET.Sdk">
  <!-- Client-only: the mission view list (HUD, order bar, scoreboard...). Not loaded by the dedicated server. -->
  <PropertyGroup>
    <AssemblyName>CommanderBattle.View</AssemblyName>
    <RootNamespace>CommanderBattle.View</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommanderBattle\CommanderBattle.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BannerlordBin)TaleWorlds.Core.dll" Private="false" />
    <Reference Include="$(BannerlordBin)TaleWorlds.Library.dll" Private="false" />
    <Reference Include="$(BannerlordBin)TaleWorlds.Engine.dll" Private="false" />
    <Reference Include="$(BannerlordBin)TaleWorlds.DotNet.dll" Private="false" />
    <Reference Include="$(BannerlordBin)TaleWorlds.ScreenSystem.dll" Private="false" />
    <Reference Include="$(BannerlordBin)TaleWorlds.InputSystem.dll" Private="false" />
    <Reference Include="$(BannerlordBin)TaleWorlds.Localization.dll" Private="false" />
    <Reference Include="$(BannerlordBin)TaleWorlds.ObjectSystem.dll" Private="false" />
    <Reference Include="$(BannerlordBin)TaleWorlds.Engine.GauntletUI.dll" Private="false" />
    <Reference Include="$(BannerlordBin)TaleWorlds.GauntletUI.Data.dll" Private="false" />
    <Reference Include="$(BannerlordBin)TaleWorlds.MountAndBlade.dll" Private="false" />
    <Reference Include="$(NativeModuleBin)TaleWorlds.MountAndBlade.View.dll" Private="false" />
    <Reference Include="$(MultiplayerModuleBin)TaleWorlds.MountAndBlade.Multiplayer.dll" Private="false" />
    <Reference Include="$(MultiplayerModuleBin)TaleWorlds.MountAndBlade.Multiplayer.View.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Module\GUI\**\*.xml" LinkBase="GUI" />
  </ItemGroup>

  <!-- UI prefabs are loaded from the module's GUI folder. -->
  <Target Name="DeployGui" AfterTargets="Build">
    <ItemGroup>
      <GuiFiles Include="..\Module\GUI\**\*.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(GuiFiles)" DestinationFiles="@(GuiFiles->'$(ModuleOutputDir)GUI\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
