<?xml version="1.0" encoding="utf-8"?>
<!-- The game mode's name and explainer, as the stock modes have in Native's native_strings.xml. The loading screen
     (LoadingWindowViewModel.SetForMultiplayer) looks them up by mission name, MultiplayerCommanderBattle; the team
     selection, lobby and server list by game type, CommanderBattle. -->
<strings>
	<string
		id="str_multiplayer_official_game_type_name.CommanderBattle"
		text="{=cb_game_type_name}Commander Battle" />
	<string
		id="str_multiplayer_official_game_type_name.MultiplayerCommanderBattle"
		text="{=cb_game_type_name}Commander Battle" />
	<string
		id="str_multiplayer_official_game_type_explainer.CommanderBattle"
		text="{=cb_game_type_explainer}·   Two armies of about 400 soldiers each, in 8 formations of infantry, archers and cavalry, led by a mounted general with his bodyguard{newline}·   Take command of a formation, or be the general, from the formation list (N); the AI leads every formation nobody commands{newline}·   When you fall, take over one of your own soldiers and keep leading{newline}·   The last side with soldiers standing wins the round; if time runs out first, the defenders win" />
	<string
		id="str_multiplayer_official_game_type_explainer.MultiplayerCommanderBattle"
		text="{=cb_game_type_explainer}·   Two armies of about 400 soldiers each, in 8 formations of infantry, archers and cavalry, led by a mounted general with his bodyguard{newline}·   Take command of a formation, or be the general, from the formation list (N); the AI leads every formation nobody commands{newline}·   When you fall, take over one of your own soldiers and keep leading{newline}·   The last side with soldiers standing wins the round; if time runs out first, the defenders win" />

	<!-- Title of the scoreboard's formation column (CommanderBattleScoreboardData). -->
	<string id="str_scoreboard_header.formation" text="{=cb_scoreboard_formation}Formation" />

