      <XmlName id="GameText" path="commander_battle_strings"/>
      <IncludedGameTypes>
        <GameType value="MultiplayerGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <!-- Commander Battle's troop types, one pair of files per culture: their characters, then the classes, which take
         over the stock class ids of each culture (merged with Native's mpcharacters / mpclassdivisions by id). A file
         per culture keeps one culture's bad node from silently dropping the others' (MBObjectManager.LoadXML). -->
