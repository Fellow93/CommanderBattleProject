<Prefab>
	<Window>
		<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.4">
			<Children>
				<Widget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="900" VerticalAlignment="Center" HorizontalAlignment="Center" Sprite="flat_panel_9">
					<Children>
						<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" MarginLeft="40" MarginRight="40" MarginTop="40" MarginBottom="40">
							<Children>
								<TextWidget Text="@Title" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50" Brush="MPEscapeMenu.Title"/>
								<TextWidget Text="@Hint" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="60" MarginBottom="10" Brush="MPEscapeMenu.ButtonText" Brush.FontSize="18"/>

								<ListPanel DataSource="{Formations}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
									<ItemTemplate>
										<ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" Command.Click="ExecuteTake" IsEnabled="@CanTake" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50" MarginBottom="6" Brush="ButtonBrush2">
											<Children>
												<ListPanel UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight" MarginLeft="20" MarginRight="20">
													<Children>
														<TextWidget Text="@Name" WidthSizePolicy="Fixed" SuggestedWidth="200" HeightSizePolicy="StretchToParent" Brush="MPEscapeMenu.ButtonText" Brush.TextHorizontalAlignment="Left"/>
														<TextWidget Text="@Troops" WidthSizePolicy="Fixed" SuggestedWidth="380" HeightSizePolicy="StretchToParent" Brush="MPEscapeMenu.ButtonText" Brush.TextHorizontalAlignment="Left"/>
														<TextWidget Text="@Commander" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MPEscapeMenu.ButtonText" Brush.TextHorizontalAlignment="Right"/>
													</Children>
												</ListPanel>
											</Children>
										</ButtonWidget>
									</ItemTemplate>
								</ListPanel>

								<ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" Command.Click="ExecuteClose" WidthSizePolicy="Fixed" SuggestedWidth="240" HeightSizePolicy="Fixed" SuggestedHeight="50" HorizontalAlignment="Center" MarginTop="20" Brush="ButtonBrush2">
									<Children>
										<TextWidget Text="@CloseText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MPEscapeMenu.ButtonText"/>
									</Children>
								</ButtonWidget>
							</Children>
						</ListPanel>
					</Children>
				</Widget>
			</Children>
		</Widget>
	</Window>
</Prefab>
