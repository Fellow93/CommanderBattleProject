<Prefab>
	<!-- Formation list (FormationSelectionVM), in the troop screen's style (CommanderBattleTroopSelection.xml): the side's
	     formations grouped by class, each with its troop type's compass icon, troops, weapons, size and commander. Your own
	     formation is highlighted and has Troops and Banner buttons; each commander's banner shows beside their name. The row's take button blocks events to its children, so the Troops
	     button sits beside it. Text sizes to its content (CoverChildren), so long names wrap instead of overflowing. -->
	<Window>
		<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#0000008C">
			<Children>
				<Widget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="1240" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#0C0A08EE">
					<Children>
						<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="5" VerticalAlignment="Top" PositionYOffset="-2" Sprite="MPClassLoadout\panels_frame" />
						<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="5" VerticalAlignment="Bottom" PositionYOffset="2" Sprite="MPClassLoadout\panels_frame" />

						<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="40" MarginRight="40" MarginTop="26" MarginBottom="28" StackLayout.LayoutMethod="VerticalTopToBottom">
							<Children>
								<!-- Header -->
								<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="MPClassLoadout.FactionText" Brush.FontSize="34" Text="@Title" />
								<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="4" Brush="CommanderBattle.Troop.SectionTitle" Brush.TextHorizontalAlignment="Center" Text="@Summary" />

								<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20" MarginTop="12" ClipContents="true">
									<Children>
										<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="664" SuggestedHeight="20" HorizontalAlignment="Center" Sprite="MPClassLoadout\divider_notched" />
										<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="664" SuggestedHeight="20" HorizontalAlignment="Center" PositionYOffset="-1" Sprite="MPClassLoadout\divider_notched" VerticalFlip="true" />
									</Children>
								</Widget>

								<!-- Formations -->
								<ListPanel DataSource="{Formations}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="10" StackLayout.LayoutMethod="VerticalTopToBottom">
									<ItemTemplate>
										<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="6" StackLayout.LayoutMethod="HorizontalLeftToRight">
											<Children>
												<!-- The icon widget picks its sprite from TroopType, as the troop screen's rows do; it sets its parent's
												     state, so it sits in its own wrapper. -->
												<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" UpdateChildrenStates="true">
													<Children>
														<MultiplayerClassLoadoutTroopSubclassButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="CommanderBattle.Troop.Option" Command.Click="ExecuteTake" IsEnabled="@CanTake" IsSelected="@IsMine" IconWidget="Icon" TroopType="@IconType" IconBrush="Compass.Type.Icons">
															<Children>
																<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="HorizontalLeftToRight" UpdateChildrenStates="true">
																	<Children>
																		<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="4" SuggestedHeight="58" VerticalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#F6A554FF" IsVisible="@IsMine" />
																		<BrushWidget Id="Icon" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="40" SuggestedHeight="40" VerticalAlignment="Center" MarginLeft="16" Brush="MPClassLoadout.TroopBanner.ItemIcon" />

																		<TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="190" VerticalAlignment="Center" MarginLeft="16" Brush="CommanderBattle.Troop.SectionTitle" Text="@Name" />

																		<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginLeft="10" MarginTop="10" MarginBottom="10" StackLayout.LayoutMethod="VerticalTopToBottom" UpdateChildrenStates="true">
																			<Children>
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="CommanderBattle.Troop.OptionName" Text="@TroopLine" />
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="2" Brush="CommanderBattle.Troop.OptionDescription" Text="@DetailLine" />
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="2" Brush="CommanderBattle.Troop.TypeTag" Text="@PendingLine" AutoHideIfEmpty="true" />
																			</Children>
																		</ListPanel>

																		<TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="230" VerticalAlignment="Center" MarginLeft="12" MarginRight="10" Brush="CommanderBattle.Troop.OptionName" Brush.TextHorizontalAlignment="Right" Text="@Commander" />

																		<!-- The commander's banner, as their formation's shields carry it this round. -->
																		<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="44" SuggestedHeight="44" VerticalAlignment="Center" MarginRight="16">
																			<Children>
																				<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@HasBanner">
																					<Children>
																						<ImageIdentifierWidget DataSource="{BannerImage}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" />
																					</Children>
																				</Widget>
																			</Children>
																		</Widget>
																	</Children>
																</ListPanel>
															</Children>
														</MultiplayerClassLoadoutTroopSubclassButtonWidget>
													</Children>
												</Widget>

												<ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="54" VerticalAlignment="Center" MarginLeft="8" Brush="CommanderBattle.Troop.Button" Command.Click="ExecuteTroops" IsVisible="@IsMine">
													<Children>
														<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="CommanderBattle.Troop.ButtonText" Text="@TroopsButtonText" />
													</Children>
												</ButtonWidget>

												<ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="54" VerticalAlignment="Center" MarginLeft="8" Brush="CommanderBattle.Troop.Button" Command.Click="ExecuteBanner" IsVisible="@IsMine">
													<Children>
														<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="CommanderBattle.Troop.ButtonText" Text="@BannerButtonText" />
													</Children>
												</ButtonWidget>
											</Children>
										</ListPanel>
									</ItemTemplate>
								</ListPanel>

								<!-- Footer: the hint and Done -->
								<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" MarginTop="22" Sprite="BlankWhiteSquare_9" Color="#F4E1C433" />
								<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="16" StackLayout.LayoutMethod="HorizontalLeftToRight">
									<Children>
										<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginRight="24" Brush="CommanderBattle.Troop.BodyText" Text="@Hint" />
										<ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="54" VerticalAlignment="Center" Brush="CommanderBattle.Troop.Button" Command.Click="ExecuteClose">
											<Children>
												<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="CommanderBattle.Troop.ButtonText" Text="@CloseText" />
											</Children>
										</ButtonWidget>
									</Children>
								</ListPanel>
							</Children>
						</ListPanel>
					</Children>
				</Widget>
			</Children>
		</Widget>
	</Window>
</Prefab>
