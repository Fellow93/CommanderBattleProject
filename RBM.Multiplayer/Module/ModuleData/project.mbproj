<?xml version="1.0" encoding="utf-8"?>
<!-- RBM's native files, merged into Native's on the server and on every client; the build copies them from RBM's
     RBMXML folder. The action set additions give battle soldiers the tired reaction clip. The native and spear combat
     parameters are RBM's movement, guard and spear tuning; they apply in either combat mode, since they load at game
     start, before a client knows the server's mode. -->
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" type="solution">
  <file id="soln_combat_system" name="ModuleData/RBM_native_parameters_tweaks.xml" type="native_parameters" />
  <file id="soln_combat_system" name="ModuleData/RBM_spear_combat_parameters.xml" type="animation_combat_parameters" />
  <file id="soln_action_sets" name="ModuleData/RBM_action_sets.xml" type="action_set" />
</base>
