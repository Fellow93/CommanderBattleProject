<?xml version="1.0" encoding="utf-8"?>
<Module>
  <Name value="RBM Multiplayer"/>
  <Id value="RBM.Multiplayer"/>
  <Version value="v0.2.0"/>
  <DefaultModule value="false"/>
  <ModuleCategory value="Multiplayer"/>
  <DependedModules>
    <DependedModule Id="Native" DependentVersion="v1.5.5" Optional="false"/>
    <DependedModule Id="Multiplayer" DependentVersion="v1.5.5" Optional="false"/>
    <DependedModule Id="CommanderBattle" Optional="true"/>
  </DependedModules>
  <SubModules>
    <!-- RBM AI + Stance: loaded by the dedicated server and by clients (the network messages must match). -->
    <SubModule>
      <Name value="RBM.Multiplayer"/>
      <DLLName value="RBM.Multiplayer.dll"/>
      <SubModuleClassType value="RBM.Multiplayer.RbmMpSubModule"/>
      <Tags>
      </Tags>
    </SubModule>
    <!-- Posture HUD: clients only. -->
    <SubModule>
      <Name value="RBM.Multiplayer.View"/>
      <DLLName value="RBM.Multiplayer.View.dll"/>
      <SubModuleClassType value="RBM.Multiplayer.View.RbmMpViewSubModule"/>
      <Tags>
        <Tag key="DedicatedServerType" value="none"/>
        <Tag key="IsNoRenderModeElement" value="false"/>
      </Tags>
    </SubModule>
  </SubModules>
  <!-- RBM's item set in multiplayer (spike): the singleplayer crafting pieces and items, then RBM's versions, which
       replace them by id (RbmXmlMerge). The mp_ items keep their stats; nothing equips these yet. RBM's weapon
       descriptions take the one-handed grip off five mp_ two-handed axes, none of them Commander Battle's.
       Left out: item modifiers, holsters (injected by RBM's own loader in SP) and the troop overhaul.
       The build copies the files (RBM.Multiplayer.csproj). -->
  <Xmls>
    <!-- RBM's managed core parameters (stun, swing speed curves, missile friction, BipedalRadius...), for every game
         type as in RBM; merged per id into Native's (RbmXmlMerge leaves them to the stock merge). -->
    <XmlNode>
      <XmlName id="CoreParameters" path="RBM_spear_managed_core_parameters"/>
    </XmlNode>
    <!-- After RBM's: the values RBM sets in code at mission load, here for every machine (BipedalRadius 0.48). -->
    <XmlNode>
      <XmlName id="CoreParameters" path="rbm_mp_core_parameters"/>
    </XmlNode>
    <XmlNode>
      <XmlName id="CraftingPieces" path="sp_crafting_pieces"/>
      <IncludedGameTypes>
        <GameType value="MultiplayerGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
      <XmlName id="CraftingPieces" path="RBMCombat_sword_blades"/>
      <IncludedGameTypes>
        <GameType value="MultiplayerGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
      <XmlName id="CraftingPieces" path="RBMCombat_sword_pieces"/>
      <IncludedGameTypes>
        <GameType value="MultiplayerGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
      <XmlName id="CraftingPieces" path="RBMCombat_mace_pieces"/>
      <IncludedGameTypes>
        <GameType value="MultiplayerGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
      <XmlName id="CraftingPieces" path="RBMCombat_axe_pieces"/>
      <IncludedGameTypes>
        <GameType value="MultiplayerGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
      <XmlName id="CraftingPieces" path="RBMCombat_couched_lances"/>
      <IncludedGameTypes>
        <GameType value="MultiplayerGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <!-- RBM rebuilds some SP weapons on other templates and pieces (battania_polearm_1_t5 takes a sword guard), which
         only its own weapon descriptions and templates allow. Both are shared with the mp_ weapons. -->
    <XmlNode>
      <XmlName id="WeaponDescriptions" path="RBMCombat_weapon_descriptions"/>
      <IncludedGameTypes>
        <GameType value="MultiplayerGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
